{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kcsi-med.local/schemas/research-result.schema.json",
  "title": "KCSI-MED ResearchResult Contract v1",
  "type": "object",
  "required": ["schema_version", "run_id", "sample_id", "provider", "model", "prediction", "usage", "latency_ms", "raw", "error", "meta"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "run_id": { "type": "string" },
    "sample_id": { "type": "string", "minLength": 1 },
    "provider": { "type": "string", "minLength": 1 },
    "model": { "type": "string", "minLength": 1 },
    "prediction": {
      "type": "object",
      "required": ["drug_name", "drug_code", "front_imprint", "back_imprint", "shape", "color", "confidence", "evidence", "uncertainty"],
      "properties": {
        "drug_name": { "type": "string" },
        "drug_code": { "type": "string" },
        "front_imprint": { "type": "string" },
        "back_imprint": { "type": "string" },
        "shape": { "type": "string" },
        "color": { "type": "string" },
        "confidence": { "type": ["number", "null"], "minimum": 0, "maximum": 100 },
        "evidence": { "type": "string" },
        "uncertainty": { "type": "string" }
      },
      "additionalProperties": false
    },
    "usage": {
      "type": "object",
      "required": ["input_tokens", "output_tokens", "cached_tokens", "cost_usd"],
      "properties": {
        "input_tokens": { "type": ["number", "null"], "minimum": 0 },
        "output_tokens": { "type": ["number", "null"], "minimum": 0 },
        "cached_tokens": { "type": ["number", "null"], "minimum": 0 },
        "cost_usd": { "type": ["number", "null"], "minimum": 0 }
      },
      "additionalProperties": false
    },
    "latency_ms": { "type": "number", "minimum": 0 },
    "raw": {},
    "error": { "type": ["string", "object", "null"] },
    "meta": { "type": "object" }
  },
  "additionalProperties": false
}
